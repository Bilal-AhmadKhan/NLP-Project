# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your values. Never commit .env.
# ---------------------------------------------------------------------------

# --- LLM via OpenRouter (https://openrouter.ai/keys) ------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# "openrouter/free" auto-picks an available free model. To pin one, use any
# model id ending in ":free" from https://openrouter.ai/models?max_price=0
# e.g. google/gemma-4-31b-it:free
OPENROUTER_MODEL=openrouter/free
LLM_TEMPERATURE=0.1

# --- Embeddings ---------------------------------------------------------------
# huggingface = local + free, no key (default)
# openrouter  = uses OPENROUTER_API_KEY, e.g. nvidia/nemotron-3.5-embed-1b:free
# google      = uses GOOGLE_API_KEY, e.g. models/gemini-embedding-001
# NOTE: changing provider/model requires rebuilding: python -m app.ingest --reset
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# GOOGLE_API_KEY=your_google_api_key_here

# --- Vector DB (Chroma) ------------------------------------------------------
CHROMA_DIR=chroma_db
CHROMA_COLLECTION=fast_documents
RETRIEVER_K=6
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
SCRAPED_DATA_DIR=data/scraped
